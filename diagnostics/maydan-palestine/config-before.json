{
  "camera_name": "Palestine Square Camera",
  "latitude": 0.0,
  "longitude": 0.0,
  "video_source": "sample_videos/maydan_palestine.mp4",
  "model": "yolov8n.pt",
  "confidence_threshold": 0.25,
  "inference_image_size": 960,
  "iou_threshold": 0.7,
  "debug_traffic_analysis": true,
  "vehicle_classes": ["car", "bus", "truck", "motorcycle"],
  "trajectory_history_size": 30,
  "trajectory_max_observation_gap_seconds": 1.0,
  "monitored_road_polygon": [[0, 60], [1024, 60], [1024, 576], [0, 576]],
  "allowed_direction": {"start": [512, 520], "end": [512, 80]},
  "event_thresholds": {
    "wrong_way_min_confidence": 0.95,
    "wrong_way_min_displacement_px": 10000.0,
    "wrong_way_min_track_points": 30,
    "stopped_vehicle_seconds": 60.0,
    "stopped_vehicle_max_speed_px_per_sec": 1.0,
    "stopped_vehicle_min_track_points": 30,
    "congestion_min_vehicles": 99,
    "congestion_duration_seconds": 60.0,
    "congestion_max_track_age_seconds": 1.0,
    "congestion_max_evaluation_gap_seconds": 1.0
  }
}

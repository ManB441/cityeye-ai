{
  "camera_name": "Demo Camera 1",
  "latitude": 40.7128,
  "longitude": -74.0060,
  "video_source": "sample_videos/traffic.mp4",
  "model": "yolov8n.pt",
  "tracker": "config/bytetrack_cityeye.yaml",
  "confidence_threshold": 0.25,
  "inference_image_size": 960,
  "iou_threshold": 0.7,
  "person_detection_enabled": true,
  "person_confidence_threshold": 0.22,
  "debug_traffic_analysis": false,
  "vehicle_classes": ["car", "bus", "truck", "motorcycle"],
  "trajectory_history_size": 30,
  "trajectory_max_observation_gap_seconds": 1.0,
  "monitored_road_polygon": [
    [100, 100],
    [540, 100],
    [540, 380],
    [100, 380]
  ],
  "allowed_direction": {
    "start": [200, 350],
    "end": [200, 150]
  },
  "event_thresholds": {
    "wrong_way_min_confidence": 0.6,
    "wrong_way_min_displacement_px": 20.0,
    "wrong_way_min_track_points": 3,
    "stopped_vehicle_seconds": 8.0,
    "stopped_vehicle_max_speed_px_per_sec": 3.0,
    "stopped_vehicle_min_track_points": 3,
    "congestion_min_vehicles": 16,
    "congestion_moderate_min_vehicles": 12,
    "congestion_min_density": 0.04,
    "congestion_max_normalized_spacing": 0.12,
    "congestion_max_normalized_movement": 0.12,
    "congestion_min_detection_confidence": 0.3,
    "congestion_perspective_weight_strength": 0.5,
    "congestion_duration_seconds": 5.0,
    "congestion_release_grace_seconds": 0.75,
    "congestion_max_track_age_seconds": 1.0,
    "congestion_max_evaluation_gap_seconds": 1.0
  }
}

CITYEYE_ENVIRONMENT=production
CITYEYE_FRONTEND_PORT=8080
CITYEYE_BACKEND_PORT=8000
CITYEYE_LOG_LEVEL=warning
CITYEYE_CORS_ORIGINS=https://CHANGE-ME.example.gov
CITYEYE_TRUSTED_HOSTS=CHANGE-ME.example.gov
CITYEYE_AUTH_REQUIRED=true
CITYEYE_SESSION_TTL_SECONDS=28800
CITYEYE_BOOTSTRAP_ADMIN_USERNAME=CHANGE-ME-admin
CITYEYE_BACKUP_INTERVAL_SECONDS=21600
CITYEYE_BACKUP_RETENTION_COUNT=28

# Supply the real value through the deployment secret manager, never Git.
CITYEYE_RTSP_URL=
